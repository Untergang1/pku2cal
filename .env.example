PKU_USERNAME=
PKU_PASSWORD=
# Optional JSON array of explicitly confirmed courses without fixed times.
# Keep course identifiers private. See README.md before setting this.
# PKU_UNSCHEDULED_COURSES=[]
# Local alternative: read a confirmed private JSON file instead of inline JSON.
# PKU_UNSCHEDULED_COURSES_FILE=data/confirmed-courses.json
# Worker only: generate with npm run token after the entrypoints are installed.
CALENDAR_TOKEN=

# Pages setup stores its separate token in ignored data/pages/<owner>/<repo>.json.
# Do not set PAGES_CALENDAR_TOKEN here for setup; it restores that private file.
# pages:prepare receives PAGES_CALENDAR_TOKEN / PAGES_BASE_URL from Actions.

# Private classroom overrides and missing courses (JSON); do not set both sources.
# PKU_COURSE_SUPPLEMENTS_FILE=data/course-supplements.json
# PKU_COURSE_SUPPLEMENTS=null
