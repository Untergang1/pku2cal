# 仅 schedule:pull 和 schedule:migrate 读取本地北大凭据。
PKU_USERNAME=
PKU_PASSWORD=

# 以下旧来源仅供 schedule:migrate 一次性迁移，日常命令不会读取。
# PKU_UNSCHEDULED_COURSES_FILE=data/confirmed-courses.json
# PKU_UNSCHEDULED_COURSES=[]
# PKU_COURSE_SUPPLEMENTS_FILE=data/course-supplements.json
# PKU_COURSE_SUPPLEMENTS=null

# 订阅令牌自动保存在忽略的 data/pages/ 与 data/worker/ 中，请私密备份。
# Worker 本地开发可在 .dev.vars 中单独设置 CALENDAR_TOKEN。
