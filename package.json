{
  "name": "pku2cal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "generate": "npm run build && node dist/entrypoints/node.js",
    "setup": "npm run build && node dist/entrypoints/setup.js",
    "status": "npm run build && node dist/entrypoints/node.js --status",
    "worker:check": "node scripts/worker-check.mjs",
    "worker:build": "npm run build && node scripts/build-worker.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && node dist/entrypoints/worker-setup.js",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "pages:prepare": "npm run build && node dist/entrypoints/pages-prepare.js",
    "schedule:pull": "npm run build && node --env-file-if-exists=.env dist/entrypoints/schedule-pull.js",
    "schedule:migrate": "npm run build && node --env-file-if-exists=.env dist/entrypoints/schedule-pull.js --migrate",
    "schedule:check": "npm run build && node dist/entrypoints/node.js --check",
    "pages:publish": "npm run build && node dist/entrypoints/pages-setup.js"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "ical.js": "2.2.1",
    "tough-cookie": "6.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20260921.0-alpha",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
